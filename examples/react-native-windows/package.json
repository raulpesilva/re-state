{
  "name": "ReStateWindows",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "start": "react-native start",
    "windows": "react-native run-windows",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck",
    "test": "jest",
    "test:windows": "jest --config jest.config.windows.js"
  },
  "dependencies": {
    "@raulpesilva/re-state": "^1.2.28",
    "react": "19.2.3",
    "react-native": "0.84.1",
    "react-native-windows": "0.84.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.84.1",
    "@react-native/metro-config": "0.84.1",
    "@react-native/typescript-config": "0.84.1",
    "@rnx-kit/jest-preset": "^0.3.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "jest": "^29.6.3",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "react-native-windows": {
    "init-windows": {
      "name": "ReStateWindows",
      "namespace": "ReStateWindows",
      "template": "cpp-app"
    }
  }
}
