{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "printWidth": 120,
  "semi": true,
  "singleQuote": true,
  "sortPackageJson": false,
  "tabWidth": 2,
  "trailingComma": "es5",
  "useTabs": false,
  "ignorePatterns": [
    "node_modules/**",
    "artifacts/**",
    "build/**",
    "coverage/**",
    "dist/**",
    "es/**",
    "lib/**",
    "types/**",
    ".rpt2_cache/**",
    "docs/**",
    "examples/**",
    "pnpm-lock.yaml",
    "*.tgz",
    "size-plugin.json",
    "stats-react.json",
    "stats.html"
  ]
}
