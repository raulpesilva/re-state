{
  "name": "@raulpesilva/re-state",
  "version": "1.2.33",
  "packageManager": "pnpm@11.7.0",
  "author": "raulpesilva",
  "repository": {
    "type": "git",
    "url": "https://github.com/raulpesilva/re-state.git"
  },
  "homepage": "https://restate.vercel.app/",
  "description": "easy way to create a shared state to the entire application",
  "license": "MIT",
  "type": "commonjs",
  "main": "lib/index.js",
  "module": "es/index.js",
  "react-native": "lib/index.native.js",
  "unpkg": "dist/re-state.production.min.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "react-native": {
        "types": "./types/index.native.d.ts",
        "default": "./lib/index.native.js"
      },
      "import": {
        "types": "./types/index.d.mts",
        "default": "./es/index.js"
      },
      "require": {
        "types": "./types/index.d.ts",
        "default": "./lib/index.js"
      },
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./types/*": {
      "types": "./types/*.d.ts",
      "import": "./es/*.js",
      "require": "./lib/*.js",
      "default": "./lib/*.js"
    },
    "./es/*.js": "./es/*.js",
    "./es/*": "./es/*.js",
    "./lib/*.js": "./lib/*.js",
    "./lib/*": "./lib/*.js",
    "./dist/*": "./dist/*"
  },
  "sideEffects": [
    "es/index.js",
    "es/index.native.js",
    "es/react/index.js",
    "es/react/index.native.js",
    "lib/index.js",
    "lib/index.native.js",
    "lib/react/index.js",
    "lib/react/index.native.js"
  ],
  "packageManager": "pnpm@11.7.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:dev": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src tsdown.config.mts vitest.config.mts",
    "lint:fix": "oxlint src tsdown.config.mts vitest.config.mts --fix",
    "format": "oxfmt --write src package.json pnpm-workspace.yaml tsconfig.json tsdown.config.mts vitest.config.mts .oxlintrc.json .oxfmtrc.json",
    "format:check": "oxfmt --check src package.json pnpm-workspace.yaml tsconfig.json tsdown.config.mts vitest.config.mts .oxlintrc.json .oxfmtrc.json",
    "examples:check": "pnpm --recursive --if-present --filter \"./examples/**\" run check",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "files": [
    "lib",
    "es",
    "dist",
    "types"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "4.1.10",
    "jsdom": "29.1.1",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsdown": "0.22.14",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@types/use-sync-external-store": "^0.0.3",
    "use-sync-external-store": "^1.2.0"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    }
  },
  "keywords": [
    "re-state",
    "re state",
    "restate",
    "react re-state",
    "react-native re-state",
    "react-native",
    "react",
    "ios",
    "android",
    "web",
    "context",
    "react context",
    "global state",
    "global",
    "state",
    "react global state",
    "global state for react"
  ]
}
