{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error"
  },
  "plugins": ["eslint", "unicorn", "oxc", "import", "react"],
  "ignorePatterns": ["node_modules/**", ".next/**", "out/**"],
  "settings": {
    "react": {
      "version": "19.2.0"
    }
  }
}
